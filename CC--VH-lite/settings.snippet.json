{
  "_comment": "Reemplaza /ABSOLUTE/PATH/TO por la ruta donde clonaste este repo. Fusiona estas llaves con tu ~/.claude/settings.json (no sobrescribas un bloque hooks existente).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_notify.py" },
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_voice_lite.py" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_notify.py" },
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_voice_lite.py" }
        ]
      }
    ]
  }
}
