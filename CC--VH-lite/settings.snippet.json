{
  "_comment": "Preferred: run `python CC--VH-lite/install.py` (it does the merge for you). Manual: replace /ABSOLUTE/PATH/TO with your clone path (use / on Windows too) and `python3`->`python` on Windows. Merge these keys into your ~/.claude/settings.json without clobbering an existing hooks block.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_notify.py" },
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_voice_lite.py" },
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_onyx_capture.py" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_onyx_capture.py" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_notify.py" },
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/claude-code-notifications/CC--VH-lite/cc_voice_lite.py" }
        ]
      }
    ]
  }
}
